NEXT_PUBLIC_API_BASE_URL=https://software.example.com/api/v1/ecommerce
NEXT_PUBLIC_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxx
API_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Tag Manager (web container). Leave empty to disable.
GTM_ID=GTM-XXXXXXX
# Optional: server-side GTM origin serving gtm.js first-party (needs the
# "Google Tag Manager: Web Container" client in the server container).
GTM_SERVER_URL=https://sgtm.example.com
# Server-side GA4 purchases (Measurement Protocol). Sent to GTM_SERVER_URL/mp/collect
# when set (needs the "Measurement Protocol (GA4)" client), else straight to Google.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=
# Consent Mode v2 defaults: granted|denied, plus regions denied until a banner
# updates consent ("EEA" = EU/EEA + UK + CH, or ISO codes like "GB,US-CA").
GTM_CONSENT_DEFAULT=granted
GTM_CONSENT_DENIED_REGIONS=
# Consent banner: off | required (only visitors whose default is denied) | all
CONSENT_BANNER=off
# Optional request header with the visitor's ISO country (e.g. set by nginx GeoIP2)
GEO_COUNTRY_HEADER=
# true once Meta CAPI runs as a server-side GTM tag (app stops its own CAPI sends)
META_VIA_SGTM=false
# Gateway purchases parked until paid (persistent, shared by all instances)
TRACKING_DATA_DIR=
# Bearer secret for POST /api/tracking/refund (backend → GA4 refunds)
TRACKING_WEBHOOK_SECRET=
# Content-Security-Policy (read at build time): off | report-only | enforce
CSP_MODE=off
CSP_EXTRA_SOURCES=
CSP_REPORT_URI=


